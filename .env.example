# 식약처(식품안전나라) OpenAPI 설정
# https://www.foodsafetykorea.go.kr/api/openApiInfo.do 에서 인증키를 발급받으세요.
# 키가 비어 있으면 식약처 연동은 자동으로 꺼지고 로컬 시드 데이터만 사용해요.

VITE_MFDS_API_KEY=

# (선택) CORS 우회용 프록시 주소.
# 식품안전나라 API는 브라우저 교차출처(CORS) 헤더를 주지 않아,
# 일반 브라우저/WebView에서 직접 호출하면 막힐 수 있어요.
# 그럴 땐 서버/프록시를 두고 그 주소를 여기에 넣으세요.
# 미설정 시 https://openapi.foodsafetykorea.go.kr/api 를 직접 호출해요.
VITE_MFDS_BASE_URL=

# (선택) 서비스 ID. 구독한 서비스에 맞게 바꾸세요.
VITE_MFDS_BARCODE_SERVICE=C005
VITE_MFDS_NUTRITION_SERVICE=I2790
